# ==========================================================
# MockMate Environment Configuration
# ==========================================================

# 1. Frontend Environment Variables (Vite)
# These are exposed to the browser client.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-key
VITE_API_URL=https://your-backend-service.onrender.com/api

# 2. Backend Server Environment Variables
# These are NEVER exposed to the frontend browser client.
PORT=5000
FRONTEND_URL=https://your-frontend-app.vercel.app,http://localhost:5173
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-secret-key
GEMINI_API_KEY=your-gemini-api-key

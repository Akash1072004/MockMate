# MockMate Backend Environment Configuration
# PORT is automatically injected by Render (defaults to 5000 locally)
PORT=5000

# Allowed production frontend URL for CORS (comma-separated if multiple)
FRONTEND_URL=https://your-frontend-app.vercel.app,http://localhost:5173

# Supabase URL & Secret Key (Server-only service role secret key)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-secret-key

# Google Gemini API Key (Server-only)
GEMINI_API_KEY=your-gemini-api-key
